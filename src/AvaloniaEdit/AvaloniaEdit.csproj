<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <WarningsNotAsErrors>0612,0618</WarningsNotAsErrors>
    <PackageId>AIGuiders.AvaloniaEdit</PackageId>
    <PackageDescription>Форк upstream AvaloniaEdit для AIGuiders / CascadeIDE: выровненная версия Avalonia и патчи для потребления пакетом (ресурсы / AVLN2000 и см.). Отдельного «полного порта AvalonEdit заново» нет — это та же кодовая база AvaloniaEdit с целевыми доработками под наш сценарий.</PackageDescription>
    <PackageTags>aiguiders;cascade;cascadeide;fork;avalonia;avaloniaedit;editor;text-editor</PackageTags>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.xshd;**\*.resx;" Exclude="bin\**;obj\**;**\*.xproj;packages\**;@(EmbeddedResource)" />
    <AvaloniaResource Include="**\*.xaml;Assets\*;" Exclude="bin\**;obj\**;**\*.xproj;packages\**;@(EmbeddedResource)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Needed for resource/XAML build targets when consumed via ProjectReference (AVLN2000 / !AvaloniaResources). -->
    <PackageReference Include="Avalonia.Desktop" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SR.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SR.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="SR.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>SR.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
<ItemGroup><Compile Update="Document\DocumentLine.LineNode.cs"><DependentUpon>DocumentLine.cs</DependentUpon></Compile></ItemGroup></Project>
